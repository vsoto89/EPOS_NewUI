<UserControl x:Class="EPOS_NewUI.Views.InformesUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7F6" FontFamily="Segoe UI">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="⬅ Volver" Width="90" Height="35" Background="#E2E8F0" Foreground="#2C3E50" BorderThickness="0" Cursor="Hand" Margin="0,0,20,0" Click="BtnVolver_Click"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Informes" FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Resumen de ventas del día" FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="2" Content="Actualizar" Width="110" Height="35" Background="#20C997" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnActualizar_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,20">
                <Border Background="White" CornerRadius="12" Width="220" Padding="20" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="Ventas totales" Foreground="#7F8C8D" FontSize="13"/>
                        <TextBlock x:Name="txtVentasTotales" Text="$0" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Width="220" Padding="20" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="Tickets" Foreground="#7F8C8D" FontSize="13"/>
                        <TextBlock x:Name="txtTickets" Text="0" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Width="220" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Promedio por ticket" Foreground="#7F8C8D" FontSize="13"/>
                        <TextBlock x:Name="txtPromedio" Text="$0" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Productos más vendidos" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <ListBox Grid.Row="1" x:Name="lbTopProductos" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Últimas ventas" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <ListBox Grid.Row="1" x:Name="lbUltimasVentas" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
