<UserControl x:Class="EPOS_NewUI.Views.AdministracionUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7F6" FontFamily="Segoe UI">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="⬅ Volver" Width="90" Height="35" Background="#E2E8F0" Foreground="#2C3E50" BorderThickness="0" Cursor="Hand" Margin="0,0,20,0" VerticalAlignment="Top" Click="BtnVolver_Click"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Administración" FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Gestión de productos del sistema" FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Datos del producto" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                    <TextBlock Text="Categoría" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbCategoria" Height="35" Margin="0,0,0,15">
                        <ComboBoxItem Content="Bebidas"/>
                        <ComboBoxItem Content="Comidas"/>
                        <ComboBoxItem Content="Postres"/>
                    </ComboBox>

                    <TextBlock Text="Nombre" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNombre" Height="35" Padding="5" Margin="0,0,0,15"/>

                    <TextBlock Text="Precio" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPrecio" Height="35" Padding="5" Margin="0,0,0,15"/>

                    <TextBlock Text="Stock" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtStock" Height="35" Padding="5" Margin="0,0,0,15"/>

                    <CheckBox x:Name="chkActivo" Content="Producto activo" IsChecked="True" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Nuevo" Width="90" Height="40" Background="#E2E8F0" Foreground="#2C3E50" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnNuevo_Click"/>
                        <Button Content="Guardar" Width="90" Height="40" Background="#20C997" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnGuardar_Click"/>
                        <Button Content="Eliminar" Width="90" Height="40" Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnEliminar_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Listado de productos" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="Haz clic en un producto para editarlo" FontSize="13" Foreground="#7F8C8D" Margin="0,3,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgProductos" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgProductos_SelectionChanged" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioFormateado}" Width="100"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
