<UserControl x:Class="EPOS_NewUI.Views.LoginUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             FontFamily="Segoe UI">

    <!-- Fondo de pantalla completo -->
    <Grid Background="#F4F7F6">

        <!-- Tarjeta de Login Centrada -->
        <Border Width="700" Height="400" Background="White" CornerRadius="12" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- Sombra de la tarjeta -->
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="20" ShadowDepth="5" Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/> <!-- Columna Izquierda (Branding) -->
                    <ColumnDefinition Width="*"/> <!-- Columna Derecha (Formulario) -->
                </Grid.ColumnDefinitions>

                <!-- LADO IZQUIERDO: Branding y Logo -->
                <Border Grid.Column="0" Background="#2C3E50" CornerRadius="12,0,0,12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="EPOS" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Premium" FontSize="24" Foreground="#20C997" HorizontalAlignment="Center" Margin="0,-10,0,20"/>
                        
                        <!-- Aquí puedes poner la imagen del local después -->
                        <TextBlock Text="Quesos Arturito" FontSize="16" Foreground="#A6B5C4" HorizontalAlignment="Center" Margin="0,40,0,0"/>
                    </StackPanel>
                </Border>

                <!-- LADO DERECHO: Formulario de Login -->
                <Grid Grid.Column="1" Margin="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Iniciar Sesión" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        
                        <!-- Perfil de usuario -->
                        <TextBlock Text="Usuario" FontSize="14" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cbUsuario" Height="35" FontSize="14" Margin="0,0,0,15" SelectedIndex="0">
                            <ComboBoxItem Content="Administrador"/>
                            <ComboBoxItem Content="Vendedor"/>
                        </ComboBox>

                        <!-- Contraseña -->
                        <TextBlock Text="Contraseña" FontSize="14" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtPassword" Height="35" FontSize="16" Padding="5"/>
                    </StackPanel>

                    <!-- Botones -->
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botón Salir (Gris claro) -->
                        <Button Grid.Column="0" Content="Salir" Height="40" FontSize="16" FontWeight="Bold" 
                                Background="#E2E8F0" Foreground="#2C3E50" BorderThickness="0" Click="btnSalir_Click" Cursor="Hand"/>

                        <!-- Botón Entrar (Verde EPOS) -->
                        <Button Grid.Column="2" Content="Entrar POS" Height="40" FontSize="16" FontWeight="Bold" 
                                Background="#20C997" Foreground="White" BorderThickness="0" Cursor="Hand" 
                                Click="btnEntrar_Click" IsDefault="True"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>