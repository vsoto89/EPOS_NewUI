<UserControl x:Class="EPOS_NewUI.Views.MaestroClientesUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7F6" FontFamily="Segoe UI">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Cabecera -->
            <RowDefinition Height="*"/>    <!-- Formulario -->
            <RowDefinition Height="Auto"/> <!-- Botones -->
        </Grid.RowDefinitions>

        <!-- Fila 0: Cabecera y Botón Volver -->
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Content="⬅ Volver" Width="80" Height="35" Background="#E2E8F0" Foreground="#2C3E50" BorderThickness="0" Cursor="Hand" Margin="0,0,20,0" VerticalAlignment="Top" Click="BtnVolver_Click"/>
            
            <StackPanel Grid.Column="1" Orientation="Vertical">
                <TextBlock Text="Maestro de Clientes" FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Gestión y registro de clientes para facturación" FontSize="14" Foreground="#7F8C8D"/>
            </StackPanel>
        </Grid>

        <!-- Fila 1: Formulario dividido en dos columnas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/> <!-- Espacio -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA IZQUIERDA: Datos Principales -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Datos Principales" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                    <TextBlock Text="RUT" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtRut" Height="35" FontSize="14" Padding="5"/>
                        <Button Grid.Column="1" Content="🔍 Buscar" Width="70" Background="#E2E8F0" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand"/>
                    </Grid>

                    <TextBlock Text="Nombre o Razón Social" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNombre" Height="35" FontSize="14" Padding="5" Margin="0,0,0,15"/>

                    <TextBlock Text="Giro Comercial" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtGiro" Height="35" FontSize="14" Padding="5" Margin="0,0,0,15"/>

                    <TextBlock Text="Correo Electrónico (E-Mail)" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEmail" Height="35" FontSize="14" Padding="5"/>
                </StackPanel>
            </Border>

            <!-- COLUMNA DERECHA: Contacto y Ubicación -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="25">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Contacto y Ubicación" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                    <TextBlock Text="Teléfono / Celular" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTelefono" Height="35" FontSize="14" Padding="5" Margin="0,0,0,15"/>

                    <TextBlock Text="Dirección" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtDireccion" Height="35" FontSize="14" Padding="5" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Comuna" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtComuna" Height="35" FontSize="14" Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ciudad" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtCiudad" Height="35" FontSize="14" Padding="5"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Fila 2: Botones de Acción -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
            <Button Content="Limpiar" Width="120" Height="40" Background="#E2E8F0" Foreground="#2C3E50" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" Click="BtnLimpiar_Click"/>
            <Button Content="Eliminar" Width="120" Height="40" Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" Click="BtnEliminar_Click"/>
            <Button Content="Guardar Cliente" Width="150" Height="40" Background="#20C997" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</UserControl>