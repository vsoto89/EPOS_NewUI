<Window x:Class="EPOS_NewUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EPOS POS" Height="800" Width="1360" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ProductButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="92"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,8,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <!-- Botones circulares para +/- -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinusButtonStyle" BasedOn="{StaticResource CircleButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="PlusButtonStyle" BasedOn="{StaticResource CircleButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Margin="20" Padding="24" Background="White" CornerRadius="18" BorderBrush="#DCE3EA" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="EPOS Premium" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Caja 01" Margin="0,6,0,0" FontSize="13" Foreground="#6B7280"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,8,0,0">
                        <TextBlock Text="Vendedor:" VerticalAlignment="Center" FontSize="14" Foreground="#374151" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SellerComboBox" Width="220" Height="28" SelectionChanged="SellerComboBox_SelectionChanged"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,18,0,14" Padding="12" Background="#F9FAFB" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Buscar producto" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                            <TextBox x:Name="SearchBox" Margin="0,6,0,0" Height="34" Padding="8" TextChanged="SearchBox_TextChanged" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="Hora" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                            <TextBlock x:Name="CurrentTimeText" Margin="0,6,0,0" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Categorías" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
                    <WrapPanel x:Name="CategoryPanel" Margin="0,10,0,0" IsEnabled="False"/>
                </StackPanel>

                <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="ProductsPanel" IsEnabled="False"/>
                </ScrollViewer>

                <StackPanel Grid.Row="4" Margin="0,16,0,0">
                    <Separator Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ClearButton" Style="{StaticResource SecondaryButtonStyle}" Content="Limpiar ticket" Width="140" Click="ClearButton_Click" Background="#E5E7EB" Foreground="#374151" IsEnabled="False"/>
                        <Button x:Name="CheckoutButton" Style="{StaticResource SecondaryButtonStyle}" Content="Cobrar" Width="140" Click="CheckoutButton_Click" Background="#10B981" Foreground="White" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="0,20,20,20" Padding="24" Background="White" CornerRadius="18" BorderBrush="#DCE3EA" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Ticket actual" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock x:Name="ItemCountText" Text="0 artículos" Margin="0,6,0,0" FontSize="14" Foreground="#6B7280"/>
                    <TextBlock Text="Cliente: Consumo en local" Margin="0,6,0,0" FontSize="14" Foreground="#6B7280"/>
                </StackPanel>

                <ListBox x:Name="TicketListBox" Grid.Row="1" Margin="0,16,0,0" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Background="#F9FAFB" CornerRadius="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{Binding UnitPriceDisplay}" Foreground="#6B7280" FontSize="13"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <Button Content="-" Width="34" Height="34" Click="DecreaseQty_Click" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Quantity}" FontSize="15" VerticalAlignment="Center" Width="44" TextAlignment="Center"/>
                                        <Button Content="+" Width="34" Height="34" Click="IncreaseQty_Click" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding SubtotalDisplay}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Padding="16" Background="#F9FAFB" CornerRadius="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SubtotalText" Text="Subtotal: $0.00" FontSize="16" Foreground="#374151"/>
                        <TextBlock x:Name="TaxText" Text="IVA: $0.00" Margin="0,4,0,0" FontSize="16" Foreground="#374151"/>
                        <TextBlock x:Name="TotalText" Text="Total: $0.00" Margin="0,10,0,0" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Estado: listo para cobrar" Margin="0,8,0,0" FontSize="14" Foreground="#6B7280"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
